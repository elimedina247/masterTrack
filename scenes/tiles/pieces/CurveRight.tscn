[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/tiles/tool/TrackPiece.cs" id="1_piece"]
[ext_resource type="Material" path="res://resources/tiles/road.tres" id="2_road"]

; A banked quarter turn, 63 m radius - TileCatalog.CornerRadius.
;
; WHY THE BANK IS A WAYPOINT ROLL AND NOT A SHAPE IN THE POLYGON
;
; It was drawn into the cross-section, which gave a lovely profile - flat inside on the ground,
; climbing to 15.2 m outside - and could not be joined to anything. CSGPolygon3D path mode sweeps
; ONE polygon, unchanged from end to end, so that bank was at full height at the entry and exit
; faces: a 15.2 m outer edge butting a straight's 2 m wall, a 13 m cliff at every seam.
;
; Roll is the one thing that can vary along a sweep, because Curve3D interpolates tilt between its
; points. So the seams sit level, the apex is rolled 25 degrees, and the bank eases in and out on
; its own - which is exactly what the hand-built corners' BankScale did, and it means this joins a
; straight flat and square.
;
; THE COST, STATED PLAINLY
;
; Roll pivots the whole section about the spine, so the inside edge dips as far below the seam
; plane as the outside rises above it - about 11 m each way at this angle. The centre line stays
; level, so there is no hump to launch off, but there is no flat inside line either: the whole road
; tips. The profiled version kept one and could not be joined; this joins and cannot keep one.
;
; Getting both needs a cross-section that changes along the sweep, which is a code sweep rather
; than a CSG one - see docs/tile-tool.md.
;
; 25 degrees is a bank a 54 m wide road can carry without the edges running away: sin 25 across 54 m
; is 22.8 m of total span. Raise it and read the height it produces before committing.
[sub_resource type="Curve3D" id="Curve_CurveRight"]

[node name="CurveRight" type="StaticBody3D"]
script = ExtResource("1_piece")

[node name="Entry" type="Marker3D" parent="."]

[node name="P1" type="Marker3D" parent="."]
transform = Transform3D(0.6408, 0.2989, -0.7071, -0.4226, 0.9063, 0, 0.6408, 0.2989, 0.7071, 18.45, 0, -44.55)

[node name="Exit" type="Marker3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 63, 0, -63)

[node name="Spine" type="Path3D" parent="."]
curve = SubResource("Curve_CurveRight")

[node name="Build" type="CSGCombiner3D" parent="."]
use_collision = true

[node name="Road" type="CSGPolygon3D" parent="Build"]
material = ExtResource("2_road")
polygon = PackedVector2Array(-27, -1.6, 27, -1.6, 27, 2, 24.57, 2, 24.57, 0, -24.57, 0, -24.57, 2, -27, 2)
mode = 2
path_node = NodePath("../../Spine")
path_interval_type = 0
path_interval = 6.0
path_simplify_angle = 1.0
path_rotation = 2
path_local = true
path_continuous_u = true
