[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/tiles/tool/TrackPiece.cs" id="1_piece"]
[ext_resource type="Material" path="res://resources/tiles/road.tres" id="2_road"]

; A banked quarter turn to the right, 63 m radius - the catalog's CornerRadius.
;
; Entry, one waypoint, Exit. The waypoint sits at the 45-degree point of the arc, faces along the
; tangent there, and is rolled 29 degrees - that roll is the bank. Drag it to reshape the corner;
; rotate it to change how hard it banks. The spine and the mesh follow.
;
; Entry and Exit are held level automatically, so the bank always eases away to flat before the
; seam and the next piece has something square to attach to.
[sub_resource type="Curve3D" id="Curve_right"]

[node name="CurveRight" type="StaticBody3D"]
script = ExtResource("1_piece")
Surface = "Road"

[node name="Entry" type="Marker3D" parent="."]

[node name="Exit" type="Marker3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 63, 0, -63)

[node name="Point" type="Marker3D" parent="."]
transform = Transform3D(0.6184, 0.3428, -0.7071, -0.4848, 0.8746, 0, 0.6184, 0.3428, 0.7071, 18.45, 0, -44.55)

[node name="Spine" type="Path3D" parent="."]
curve = SubResource("Curve_right")

[node name="Build" type="CSGCombiner3D" parent="."]
use_collision = true

