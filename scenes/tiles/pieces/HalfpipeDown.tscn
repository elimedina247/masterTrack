[node name="HalfpipeDown" type="StaticBody3D" unique_id=777167844]
script = ExtResource("1_piece")
DeckWeight = 2.0
DeckDescription = "A snowboarder's halfpipe tipped downhill: flat ice up the middle, frozen walls curling away to dead vertical either side. The floor is the coward's line. The walls carry speed the floor never will — carve up, hang over the lip, drop back in — but every metre of height is a metre of falling if the carve goes wrong."

