[ext_resource type="Script" path="res://scripts/tiles/tool/TrackPiece.cs" id="1_piece"]
[ext_resource type="Resource" path="res://resources/tiles/road_flat.tres" id="2_profile"]

; A one-cube climb: 36 m of rise over 108 m of run, which is TileCatalog.HeightStep.
;
; Four points rather than two, and that is the whole content of the piece. Two points with
; horizontal handles gives a smoothstep, which sounds smooth and is not - its slope peaks at 1.5x
; its own average, so the middle of this ramp would reach 35 degrees while reading 18 on paper, and
; the angle would be changing everywhere. The two inner points instead hold a constant slope
; through the middle at rise / (run * 0.78) = 23 degrees, with the curvature spent easing into it
; at each end.
;
; The end handles are horizontal on purpose and TrackPiece will warn if they stop being: the chain
; carries a position and a yaw with no pitch, so a ramp that is still climbing at the seam hands
; its neighbour a frame the anchor cannot represent and the joint becomes a kerb.
;
; This is the piece most worth dragging. The numbers below are the tuned profile the hand-built
; ramps arrived at; whether it is the ramp that plays best is a question for the viewport.
[sub_resource type="Curve3D" id="Curve_ramp"]
up_vector_enabled = true
_data = {
"points": PackedVector3Array(0, 0, 0, 0, 0, -12, 0, 0, 0, 0, -4.7, 11, 0, 8.6, -20.2, 0, 5.08, -23.76, 0, -8.6, 20.2, 0, 4.7, -11, 0, 30.92, -84.24, 0, 0, 12, 0, 0, 0, 0, 36, -108),
"tilts": PackedFloat32Array(0, 0, 0, 0)
}
point_count = 4

