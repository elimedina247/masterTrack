[ext_resource type="Script" path="res://scripts/tiles/tool/TrackPiece.cs" id="1_piece"]
[ext_resource type="Material" path="res://resources/tiles/road.tres" id="2_road"]

; A parking-garage spiral: one full turn to the right around a 45 m circle while climbing 72 m.
;
; The exit lands directly above the entry, still heading -Z, which is exactly what a garage ramp
; does. That is expressible only because the contract is the transform between two markers - the
; anchor carries height as well as position, so "72 m up, same heading" is an ordinary seam.
;
; Five points, one per quarter plus the close. The middle three carry tilt, which is the bank: with
; path_rotation = PATH_FOLLOW the cross-section rolls with it. Flip the sign if it banks the wrong
; way; the outside of a right-hand turn is the left, and 0.3 rad is about 17 degrees.
;
; The first and last handles are deliberately horizontal. A helix climbs at a constant angle, and
; if it were still climbing at the seam the next piece would be built flat against it and the joint
; would be a kerb - so the climb eases in and out, and TrackPiece warns if it stops doing that.
[sub_resource type="Curve3D" id="Curve_twist"]
_data = {
"points": PackedVector3Array(0, 0, 0, 0, 0, -24.85, 0, 0, 0, -24.85, -6.33, 0, 24.85, 6.33, 0, 45, 18, -45, 0, -6.33, -24.85, 0, 6.33, 24.85, 90, 36, 0, 24.85, -6.33, 0, -24.85, 6.33, 0, 45, 54, 45, 0, 0, 24.85, 0, 0, 0, 0, 72, 0),
"tilts": PackedFloat32Array(0, 0.3, 0.3, 0.3, 0)
}
point_count = 5

