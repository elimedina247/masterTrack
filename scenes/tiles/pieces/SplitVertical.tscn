[node name="SplitVertical" type="StaticBody3D" unique_id=1942537131]
script = ExtResource("1_piece")
DeckWeight = 3.0
DeckDescription = "The road tears in two: the left lane climbs a shelf, the right dives into a trench, and they slam back together at the far end. Neither is free — the shelf costs speed going up, the trench costs nerve coming out. The low lane wants the track up in the air."

