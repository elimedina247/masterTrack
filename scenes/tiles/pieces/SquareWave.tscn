[node name="SquareWave" type="StaticBody3D" unique_id=1089219777]
script = ExtResource("1_piece")
DeckDescription = "A square wave stood on its side: six flat peaks, each a step lower than the last, with nothing between them but air. Kick up onto the first and ride the wave down - every gap is a jump that lands downhill, and losing the rhythm once is a long fall from a short place."

