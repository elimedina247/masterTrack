[node name="HairpinRight" type="StaticBody3D" unique_id=552009349]
script = ExtResource("1_piece")
DeckWeight = 3.0
DeckDescription = "A 180-degree turn to the right, walled higher and steeper than any corner. Crawl the flat inside lane, or ride the wall the long way round at speed - and getting it wrong up there drops you back down the bank having lost everything."

